<?php

define('ROLE_ADMIN', '3');
define('ROLE_MANAGER_PRODUCTION', '4');
define('ROLE_USER_PRODUCTION', '6');
const ADMIN_RID = 3;
const MANAGER_PRODUCTION_RID = 4;
const USER_PRODUCTION_RID = 6;
const CLIENT_RID = 7;
const MANAGER_RID = 8;
const COMPANY_TD = 3151;


/**
 * Implementation of hook_menu_alter().
 */
function ext_user_menu_alter(&$items)
{
  // убрать восстановление пароля со страницы входа
//  $items['user/password']['access callback'] = false;
}

/**
 * hook_module_implements_alter
 * change hook execution order, commerce_helper - last
 */
function ext_user_module_implements_alter(&$implementations, $hook)
{
  // Name of the hook.
  if (in_array($hook, ['form_alter'])) {
    // ext_user - last
    $module = 'ext_user';
    if (isset($implementations[$module])) {
      $group = $implementations[$module];
      unset($implementations[$module]);
      $implementations[$module] = $group;
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function ext_user_form_user_pass_alter(&$form, &$form_state)
{
  if (!user_has_role(ADMIN_RID)) {
    $form['#prefix'] = '<div class="user-auth-form-wrapper">';
    $form['#prefix'] .= '<h1>' . t('Recover password') . '</h1>';
    $form['#prefix'] .= '<div class="user-links">' . t('or') .  ' <a href="' . url('user/login') . '">' . t('Log in') . '</a></div>';
    $form['#suffix'] = '</div>';
    $form["mail"]["#markup"] = t('The recovery link will be sent to E-Mail above.');
    $form["actions"]["submit"]['#value'] = t('Send me link');
    $form["actions"]["submit"]['#attributes']['class'] = ['btn', 'btn-brand', 'btn-wide'];

    array_unshift($form['#submit'], 'ext_user_user_pass_submit');
  }
}

function ext_user_user_pass_submit($form, $form_state)
{
  // запишем фразу с переводом
  variable_set('user_password_reset_text', t(variable_get('user_password_reset_text')));
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function ext_user_form_user_login_alter(&$form, &$form_state)
{
  $form['#prefix'] =  '<div class="user-auth-form-wrapper">';
  $form['#prefix'] .=   '<h1>' . t('Log in') . '</h1>';
  $form['#prefix'] .=   '<div class="user-links">' . t('or') .  ' <a href="' . url('user/password') . '">' . t('Recover password') . '</a></div>';
  $form['#suffix'] =  '</div>';

  $form['name']['#title'] = t('E-Mail');
  $form['name']['#element_validate'][] = 'ext_user_login_name_validate';
  $form["pass"]["#title"] = t('Password');
  unset($form['name']['#description']);
  unset($form['pass']['#description']);
  $form["actions"]["submit"]['#value'] = t('Log in');
  $form["actions"]["submit"]['#attributes']['class'] = ['btn', 'btn-brand', 'btn-wide'];

  $form["#submit"][] = 'ext_user_user_profile_form_submit';
}

/**
 * Form element validation handler for the user login form.
 *
 * Allows users to authenticate by username OR email.
 */
function ext_user_login_name_validate($form, &$form_state)
{
  $user = ext_user_user_load_by_login($form_state['values']['name']);
  if ($user->uid) {
    $form_state['values']['name'] = $user->name;
    return TRUE;
  }

  return FALSE;
}

/**
 * Implements hook_form_alter().
 */
function ext_user_form_user_profile_form_alter(&$form, &$form_state)
{
  // в профиле оставляем только смену пароля
  if (!user_has_role(ADMIN_RID)) {
    $form["actions"]["submit"]['#attributes']['class'] = ['btn', 'btn-brand'];
    $form["actions"]["submit"]['#value'] = 'Сохранить';

    $form["field_user_companies"]["#access"] = false;

    if ($form["#user_category"] == 'account') {
      $form['#prefix'] =  '<div class="user-auth-form-wrapper">';
      $form['#prefix'] .=   '<h1>Смена пароля</h1>';
      $form['#suffix'] =  '</div>';
      if (isset($form["account"]["pass"])) {
        $form["account"]["current_pass"]["#title"] = 'Старый пароль';
        $form["account"]["current_pass"]["#description"] = 'Для смены сначала введите текущий пароль';
        $form["account"]["pass"]["#title"] = 'Новый пароль';
        $form["account"]["pass"]["#description"] = '';
        $form["account"]["pass"]["#type"] = 'password';
      }
      $form["locale"]["#access"] = false;
      $form["mimemail"]["#access"] = false;
      $form["timezone"]["#access"] = false;
      $form["account"]["mail"]["#access"] = false;
    }
    if (!ext_user_has_roles([ROLE_MANAGER_PRODUCTION, MANAGER_RID])) {
      $form["field_notify_query"]["#access"] = false;
    }
    if (!ext_user_has_roles([ROLE_USER_PRODUCTION, CLIENT_RID])) {
      $form["field_notify_once_a_day"]["#access"] = false;
    }

    $form["#submit"][] = 'ext_user_user_profile_form_submit';
  }
}

function ext_user_user_profile_form_submit($form, &$form_state)
{
  // после смены пароля редирект на главную
  $form_state['redirect'] = '<front>';
}

/**
 * Загрузить пользователя по указанному логину
 * @param $login
 *
 * @return object
 */
function ext_user_user_load_by_login($login)
{
  // Try loading by email.
  if ($user = user_load_by_mail($login)) {
    return $user;
  }

  // Try loading by username.
  if ($user = user_load_by_name($login)) {
    return $user;
  }
  return user_load(0);
}

/**
 * Вернуть Клиентов по заданной Компании и Роли
 * @param $company_id
 * @param $role -
 *
 * @return array of stdClass
 */
function ext_user_get_users_by_company_id($company_id, $role)
{
  $users = [];
  if (is_numeric($company_id)) {
    $query = db_select('users', 'u');
    $query ->condition('u.status', 1);
    $query ->fields('u', ['uid']);
    $query ->innerJoin('field_data_field_user_companies', 'fc', 'fc.entity_id = u.uid');
    $query ->condition('fc.field_user_companies_tid', $company_id);
    $query->innerJoin('users_roles', 'ur', 'ur.uid = u.uid');
    $query->condition('ur.rid', $role);
    $uids = $query->execute()->fetchCol();
    if ($uids) {
      $users = user_load_multiple($uids);
    }
  }

  return $users;
}

/**
 * Вернуть список Компаний, доступных пользователю.
 * Для менеджеров производства доступны все.
 * @param $user
 */
function ext_user_get_companies_by_user($user = null)
{
  if (!$user) $user = user_load($GLOBALS['user']->uid);
  if (is_numeric($user)) {
    $user = user_load($user);
  }

  $companies = [];
  $tids = [];
  $user_wr = entity_metadata_wrapper('user', $user);
  // для клиентов и менеджеров, у кого задан список компаний
  if ((ext_user_has_roles([USER_PRODUCTION_RID, CLIENT_RID]) || ext_user_has_roles([MANAGER_PRODUCTION_RID, MANAGER_RID])) && count($user_wr->field_user_companies->raw())) {
    $tids = $user_wr->field_user_companies->raw();
  }
  // для менеджеров без списка компаний вывести все
  elseif (ext_user_has_roles([ROLE_MANAGER_PRODUCTION, MANAGER_RID])) {
    $query = db_select('taxonomy_term_data', 't');
    $query ->condition('t.vid', taxonomy_vocabulary_machine_name_load('clients')->vid);
    $query ->fields('t', ['tid']);
    $tids = $query->execute()->fetchCol();
  }

  if ($tids) {
    foreach ($tids as $tid) {
      $companies[$tid] = ext_user_get_company_info($tid);
    }
  }

  return $companies;
}

/**
 * Вернуть информацию о Компании
 * @param $id
 */
function ext_user_get_company_info($id)
{
  $info = [];

  $term_wr = entity_metadata_wrapper('taxonomy_term', $id);
  if ($term_wr->value()) {
    $info = [
      'id' => $term_wr->getIdentifier(),
      'name' => $term_wr->label(),
      'id_1c' => $term_wr->field_1c_id->value(),
    ];
  }

  return $info;
}

/**
 * Сохранить значение переменной для Пользователя.
 * Удалить, если $value == null
 * @param $name
 * @param $value
 */
function ext_user_store_session_setting($name, $value)
{
  if (!isset($value) && isset($_SESSION[$name])) {
    unset($_SESSION[$name]);
  }

  if (isset($value)) {
    $_SESSION[$name] = $value;
  }
}

/**
 * Вернуть значение переменной для Пользователя
 * @param $name
 * @return mixed|null
 */
function ext_user_get_session_setting($name)
{
  return $_SESSION[$name] ?? null;
}

/**
 * Определить наличие роли у текущего пользователя
 * @param $rids - массив ID ролей
 * @param $account -
 * @return bool
 */
function ext_user_has_roles($rids, $account = null)
{
  $account = $account ?? $GLOBALS['user'];
  $account_rids = array_keys($account->roles);

  return (bool)array_intersect($rids, $account_rids);
}

/**
 * Implements hook_preprocess_HOOK().
 */
function ext_user_preprocess_user_profile(&$vars)
{
  // подготовить переменные для user-profile.tpl.php
  if ($GLOBALS['theme'] != 'seven') {
    $account = $vars['elements']['#account'];
    $vars['user_info'] = ext_user_get_user_info($account->uid);
    if (user_has_role(CLIENT_RID, $account)) {
      $vars['client_settings_form'] = drupal_get_form('ext_user_client_settings_form', $account);
    }
    if (user_has_role(MANAGER_RID, $account)) {
      $vars['manager_settings_form'] = drupal_get_form('ext_user_manager_settings_form', $account);
    }
  }
}

function ext_user_client_settings_form($form, $form_state, $account = null)
{
  $account = $account ?? $GLOBALS['user']->uid;
  $user_settings = variable_get('user_settings_' . $account->uid);

  if (isset($form_state['triggering_element'])) {
    $value = $form_state["triggering_element"]["#value"];
    if (strpos($form_state['triggering_element']['#name'], 'mails') === 0) {
      $user_settings['mail']['base'] = $value;
    }
    if ($form_state['triggering_element']['#name'] == 'frequency') {
      $user_settings['mail']['frequency'] = $value;
    }
    if (strpos($form_state['triggering_element']['#name'], 'themes') === 0) {
      $tid = $form_state["triggering_element"]["#return_value"];
      $user_settings['mail']['themes'][$tid] = (int)(bool)$value;
    }

    variable_set('user_settings_' . $account->uid, $user_settings);
  }


  $form['#prefix'] = '<div id="client-settings-form-wrapper">';
  $form['#suffix'] = '</div>';
  $form['mails'] = [
    '#title' => 'Рассылка',
    '#description' => 'уведомления об изменениях плана производства',
    '#type' => 'checkboxes',
    '#name' => 'mails',
    '#options' => [
      1 => 'включить',
    ],
    '#default_value' => [1 => $user_settings['mail']['base'] ?? 1],
    '#ajax' => [
      'wrapper' => 'client-settings-form-wrapper',
      'callback' => 'ext_user_client_settings_form_ajax',
    ],
  ];

  $form['frequency'] = [
    '#title' => 'Частота уведомлений',
    '#type' => 'select',
    '#name' => 'frequency',
    '#options' => [
      1 => 'сразу после изменения плана',
      2 => 'сводка раз в сутки',
    ],
    '#default_value' => $user_settings['mail']['frequency'] ?? 2,
    '#disabled' => isset($user_settings['mail']['base']) && !$user_settings['mail']['base'],
    '#ajax' => [
      'wrapper' => 'client-settings-form-wrapper',
      'callback' => 'ext_user_client_settings_form_ajax',
    ],
  ];

  // определить список опций
  $options = [];
  $defaults = [];
  if ($terms = taxonomy_get_tree(taxonomy_vocabulary_machine_name_load('plan_changes')->vid)) {
    foreach ($terms as $term) {
      $options[$term->tid] = $term->name;
      // по умолчанию все включены, кроме PROD_CHANGE_APPROVE
      if ($term->tid == PROD_CHANGE_APPROVE) {
        if (!empty($user_settings['mail']['themes'][$term->tid])) $defaults[] = $term->tid;
      } else {
        if (!isset($user_settings['mail']['themes'][$term->tid]) || $user_settings['mail']['themes'][$term->tid]) $defaults[] = $term->tid;
      }
    }
  }
  $form['themes'] = [
    '#title' => 'Темы уведомлений',
    '#description' => 'Выберите темы сообщений от производства, уведомления о которых вы хотите получать на почту',
    '#type' => 'checkboxes',
    '#name' => 'themes',
    '#options' => $options,
    '#default_value' => $defaults,
    '#disabled' => isset($user_settings['mail']['base']) && !$user_settings['mail']['base'],
    '#ajax' => [
      'wrapper' => 'client-settings-form-wrapper',
      'callback' => 'ext_user_client_settings_form_ajax',
    ],
  ];

  $form['nom'] = [
    '#type' => 'item',
    '#title' => 'По номенклатуре',
    '#markup' =>  '<div class="form-markup' . (isset($user_settings['mail']['base']) && !$user_settings['mail']['base'] ? ' form-disabled' : '') . '">' .
                    'Отключить рассылку для конкретной номенклатуры можно на странице заявки на её производство.<br>Для этого в блоке "Настройки" снимите соответствующую галочку.' .
                  '</div>',
  ];

  return $form;
}
function ext_user_client_settings_form_ajax($form, $form_state)
{
  return $form;
}

