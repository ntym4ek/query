{
  return $form;
}

function ext_user_preprocess_page(&$vars)
{
  if (arg(0) == 'user') {
    $vars['banner_title'] = arg(1) == $GLOBALS['user']->uid ? 'Личный кабинет' : 'Кабинет клиента';
    $vars['title'] = '';
    if (isset($vars["tabs"])) {
      unset($vars["tabs"]);
    }
  }
}

/**
 * Вернуть массив с информацией о Пользователе
 */
function ext_user_get_user_info($user = null)
{
  if (empty($user)) $user = $GLOBALS['user']->uid;
  $key = $user->uid ?? $user;
  $result = &drupal_static(__FUNCTION__ . serialize($key));

  if (empty($result)) {
    $account = is_numeric($user) ? user_load($user) : $user;
    $name = '';

    $label = t('User');
    if (ext_user_has_roles([CLIENT_RID, USER_PRODUCTION_RID], $account)) $label = 'Клиент';
    if (ext_user_has_roles([MANAGER_RID, MANAGER_PRODUCTION_RID], $account)) $label = 'Производство';
    if (ext_user_has_roles([ADMIN_RID], $account)) $label = 'Админ';

    $companies = ['list' => [], 'formatted' => ''];
    if (!empty($account->uid)) {
      $user_wr = entity_metadata_wrapper('user', $account->uid);
      $name = $user_wr->label();

      // компания
      $f = [];
      foreach ($user_wr->field_user_companies->getIterator() as $company_wr) {
        $companies['list'][$company_wr->getIdentifier()] = [
          'id' => $company_wr->getIdentifier(),
          'label' => $company_wr->label(),
        ];
        $f[] = $company_wr->label();
      }
      if ($f) $companies['formatted'] = implode(', ', $f);
    }

    $result = [
      'id' => $account->uid,
      'status' => $account->status,
      'label' => $label,
      'email' => $account->mail,
      'name' => $name,
      'companies' => $companies,
      'url' => url('user/' . $account->uid)
    ];
  }

  return $result;
}

function ext_user_managers_get_to_notify()
{
  $users = [];

  $dbr = db_select('users', 'u');
  $dbr->condition('u.status', 1);
  $dbr->innerJoin('users_roles', 'ur', 'ur.uid = u.uid');
  $dbr->condition('ur.rid', MANAGER_RID);
  $dbr->addField('u', 'uid');

  if ($result = $dbr->execute()->fetchCol()) {
    $list = user_load_multiple($result);
    foreach ($list as $key => $item) {
      // в зависимости от настроек
      $user_settings = variable_get('user_settings_' . $item->uid);
      // включена ли рассылка (по умолчанию Вкл)
      if (!isset($user_settings['mail']['base']) || $user_settings['mail']['base']) {
        $users[$key] = $item;
      }
    }
  }

  return $users ?? false;
}
